{
  "name": "FRCBatteryDashboard",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "pnpm --dir dashboard install",
    "build": "pnpm --dir dashboard run build",
    "typecheck": "tsc -p server/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "gts": "7.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
}